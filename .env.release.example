# Copy to .env.release (ignored by git) and restrict it with chmod 600.
# These credentials sign the Play upload AAB and your direct-download APK.
# Cross-store in-place upgrades require APKs signed by the same app-signing key;
# a Play upload key is usually not the Play app-signing key.
TINYHACK_SSH_KEYSTORE_PATH=/absolute/path/to/tinyhack-ssh-upload.jks
TINYHACK_SSH_KEYSTORE_PASSWORD=replace-me
TINYHACK_SSH_KEY_ALIAS=tinyhack-ssh-upload
TINYHACK_SSH_KEY_PASSWORD=replace-me

# Optional override:
# TINYHACK_SSH_GRADLE_BIN=/home/yohanes/apps/gradle-8.13/bin/gradle
