--- a/src/terminal/c/terminal.zig
+++ b/src/terminal/c/terminal.zig
@@ -1,4 +1,37 @@
 const builtin = @import("builtin");
+test "OSC 99 chunk callback" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 80, 24));
+    defer free(t);
+    const S = struct {
+        var count: usize = 0;
+        var metadata: [64]u8 = undefined;
+        var metadata_len: usize = 0;
+        var payload: [64]u8 = undefined;
+        var payload_len: usize = 0;
+        fn notify(_: Terminal, _: ?*anyopaque, chunk: *const KittyNotification) callconv(lib.calling_conv) void {
+            count += 1;
+            metadata_len = chunk.metadata.len;
+            payload_len = chunk.payload.len;
+            @memcpy(metadata[0..metadata_len], chunk.metadata.ptr[0..metadata_len]);
+            @memcpy(payload[0..payload_len], chunk.payload.ptr[0..payload_len]);
+        }
+    };
+    S.count = 0;
+    try testing.expectEqual(Result.success, set(t, .kitty_notification, @ptrCast(&S.notify)));
+    const first = "\x1b]99;i=build:d=0;Hi ";
+    const second = "\xf0\x9f\x98\x80\x1b\\";
+    vt_write(t, first, first.len);
+    try testing.expectEqual(@as(usize, 0), S.count);
+    vt_write(t, second, second.len);
+    try testing.expectEqual(@as(usize, 1), S.count);
+    try testing.expectEqualStrings("i=build:d=0", S.metadata[0..S.metadata_len]);
+    try testing.expectEqualStrings("Hi \xf0\x9f\x98\x80", S.payload[0..S.payload_len]);
+    try testing.expectEqual(Result.success, set(t, .kitty_notification, null));
+    vt_write(t, first, first.len);
+    vt_write(t, second, second.len);
+    try testing.expectEqual(@as(usize, 1), S.count);
+}
 const std = @import("std");
 const testing = std.testing;
 const build_options = @import("terminal_options");
