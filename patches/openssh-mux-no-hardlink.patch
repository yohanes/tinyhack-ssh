+#ifdef __ANDROID__
+/*
+ * Android forbids hard links in app data (SELinux), so the link() in
+ * muxserver_listen() fails with EACCES. Fall back to rename(). rename()
+ * silently replaces an existing socket, so keep link()'s "already exists"
+ * check with lstat() first; the small race only matters between two
+ * masters of the same app competing for one ControlPath.
+ */
+static int
+mux_rename_fallback(const char *tmp_path, const char *path)
+{
+	struct stat st;
+
+	if (errno != EACCES && errno != EPERM)
+		return -1;
+	if (lstat(path, &st) == 0) {
+		errno = EEXIST;
+		return -1;
+	}
+	return rename(tmp_path, path);
+}
+#endif
