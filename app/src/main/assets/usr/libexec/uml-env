#!/bin/bash
set -euo pipefail
umask 077
BASE="$HOME/uml"
ENVS="$BASE/envs"
SHARE="$HOME/../usr/share/uml"
NATIVE=$(dirname "$(readlink /proc/$$/exe)")
memory=
share_home=
fail() { echo "uml-env: $*" >&2; exit 1; }
usage() {
    echo 'uml-env create -t debian|ubuntu -n NAME -d SIZE -u USER [--memory SIZE] [--share-home on|off]'
    echo 'uml-env start NAME [--memory SIZE]'
    echo 'uml-env config NAME [--memory SIZE] [--share-home on|off]'
    echo 'uml-env delete NAME [--yes]'
    echo 'uml-env list'
    echo 'uml-env status'
    echo 'Sizes: 512M or larger, e.g. 1024M, 4G. Creation needs internet access.'
    echo 'Memory: 256M through 64G; default 512M. Config changes apply on next start.'
    echo 'Share home: the app home folder appears at /data inside the guest (default on).'
}
valid_name() { [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$ ]]; }
# Bundled templates are content-addressed; the build script prints each name.
bundled_template() {
    case "$1" in
        debian) printf '%s' "$SHARE/debian-05a1e473306ab6ed.ext4.gzip" ;;
        ubuntu) printf '%s' "$SHARE/ubuntu-22cc56fb8a542318.ext4.gzip" ;;
        *) return 1 ;;
    esac
}
type_label() {
    case "$1" in debian) echo Debian ;; ubuntu) echo Ubuntu ;; *) echo "$1" ;; esac
}
normalize_memory() {
    [[ $1 =~ ^([1-9][0-9]{0,5})([MG])$ ]] || fail 'Memory must be an integer followed by M or G, e.g. 4096M or 4G.'
    local mb=${BASH_REMATCH[1]}
    [[ ${BASH_REMATCH[2]} == M ]] || mb=$((mb * 1024))
    (( mb >= 256 && mb <= 65536 )) || fail 'Memory must be between 256M and 64G.'
    printf '%sM' "$mb"
}
normalize_switch() {
    case "$1" in
        on|yes|true|1) printf 'on' ;;
        off|no|false|0) printf 'off' ;;
        *) fail 'Use on or off for --share-home.' ;;
    esac
}
saved_memory() {
    if [[ -f "$DIR/memory" ]]; then cat "$DIR/memory"; else printf '512M'; fi
}
saved_share_home() {
    if [[ -f "$DIR/share-home" ]]; then normalize_switch "$(cat "$DIR/share-home")"; else printf 'on'; fi
}
resolve_memory() {
    memory=$(normalize_memory "${memory:-${UML_MEMORY:-$(saved_memory)}}")
}
# Atomic replacement allows configuring the next boot while a guest runs.
save_setting() {
    local tmp
    tmp=$(mktemp "$DIR/.$1.XXXXXX")
    printf '%s\n' "$2" > "$tmp"
    mv -f "$tmp" "$DIR/$1"
}
is_running() {
    [[ -f "$1/run.lock" ]] || return 1
    ! ( exec 8<"$1/run.lock"; flock -n 8 ) 2>/dev/null
}
require_ready() {
    valid_name "$1" || fail 'Invalid environment name.'
    DIR="$ENVS/$1"
    [[ -f "$DIR/ready" && -f "$DIR/disk.ext4" ]] || fail "Environment not found or creation incomplete: $1"
}
run_guest() {
    local mode=$1
    exec 9>"$DIR/run.lock"
    flock -n 9 || fail 'This environment is already running.'
    mkdir -p "$DIR/tmp"
    export TMPDIR="$DIR/tmp" PASST_NO_SANDBOX=1
    local command=("$NATIVE/libuml.so" "mem=$memory" "ubd0=$DIR/disk.ext4" root=/dev/ubda rw init=/init con=null con0=fd:0,fd:1 "stub_exe=$NATIVE/libuml-stub.so")
    # The boot shim mounts the disk and adds /data before the disk's /init.
    if [[ -f "$SHARE/shim.cpio" ]]; then
        command+=("initrd=$SHARE/shim.cpio")
        if [[ $(saved_share_home) == on ]]; then
            local home
            home=$(cd "$HOME" && pwd -P)
            if [[ $home =~ ^/[^[:space:],\"]+$ ]]; then
                command+=("th_home=$home" th_share=1)
            else
                echo "uml-env: the app home path cannot be shared: $home" >&2
            fi
        fi
    fi
    [[ $mode == create ]] && command+=("uml_create=$user")
    [[ -f "$NATIVE/libuml-net.so" ]] || fail 'UML networking is not installed.'
    command=("$NATIVE/libuml-net.so" --passt "$NATIVE/libuml-passt.so" -- "${command[@]}")
    local quoted
    printf -v quoted '%q ' "${command[@]}"
    script -q -c "$quoted" "$DIR/console.log"
}
operation=${1:-help}
[[ $# == 0 ]] || shift
case "$operation" in
help|--help|-h) usage ;;
list)
    [[ $# == 0 ]] || fail 'Usage: uml-env list'
    for dir in "$ENVS"/*; do
        [[ -f "$dir/ready" && -f "$dir/disk.ext4" ]] || continue
        printf '%s\n' "${dir##*/}"
    done ;;
status)
    # One tab-separated line per environment, for the app's manager screen:
    # name state type user memory share-home disk-bytes used-KiB
    [[ $# == 0 ]] || fail 'Usage: uml-env status'
    for dir in "$ENVS"/*; do
        [[ -d "$dir" ]] || continue
        name=${dir##*/}
        valid_name "$name" || continue
        DIR=$dir
        state=incomplete
        [[ -f "$dir/ready" && -f "$dir/disk.ext4" ]] && state=ready
        if is_running "$dir"; then
            if [[ $state == ready ]]; then state=running; else state=creating; fi
        fi
        type=$(cat "$dir/type" 2>/dev/null || echo debian)
        user=$(cat "$dir/user" 2>/dev/null || echo '')
        mem=$(normalize_memory "$(saved_memory)" 2>/dev/null || echo 512M)
        size=0 used=0
        if [[ -f "$dir/disk.ext4" ]]; then
            # Logical size from ls (no stat applet); du counts allocated blocks.
            read -r _ _ _ _ size _ < <(ls -ln "$dir/disk.ext4" 2>/dev/null) || size=0
            read -r used _ < <(du -k "$dir/disk.ext4" 2>/dev/null) || used=0
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$state" "$type" "$user" "$mem" \
            "$(saved_share_home 2>/dev/null || echo on)" "$size" "${used:-0}"
    done ;;
create)
    type=debian name= size=1024M user=user
    while [[ $# -gt 0 ]]; do
        [[ $# -ge 2 ]] || fail "Missing value for $1"
        case "$1" in
            -t|--type) type=$2 ;; -n|--name) name=$2 ;;
            -d|--disk-size) size=$2 ;; -u|--user) user=$2 ;;
            --memory) memory=$2 ;;
            --share-home) share_home=$(normalize_switch "$2") ;;
            *) fail "Unknown option: $1" ;;
        esac
        shift 2
    done
    bundled_template "$type" >/dev/null || fail "Unsupported image type: $type (use debian or ubuntu)"
    valid_name "$name" || fail 'Use a name of 1–48 letters, digits, underscores or hyphens, starting with a letter or digit.'
    [[ $user =~ ^[a-z][a-z0-9_-]{0,30}$ && $user != root ]] || fail 'Use a non-root Linux username (lowercase letters, digits, underscores or hyphens).'
    [[ $size =~ ^([1-9][0-9]{0,5})([MG])$ ]] || fail 'Size must be an integer followed by M or G.'
    mb=${BASH_REMATCH[1]}
    [[ ${BASH_REMATCH[2]} == M ]] || mb=$((mb * 1024))
    (( mb >= 512 && mb <= 1048576 )) || fail 'Disk size must be between 512M and 1024G.'
    label=$(type_label "$type")
    template="$BASE/templates/$type.ext4.gz"
    [[ -f "$template" ]] || template=$(bundled_template "$type")
    [[ -f "$template" ]] || fail "$label template missing. Restart the app to finish installing its bundled files."
    [[ -f "$NATIVE/libuml.so" ]] || fail 'This app build does not include UML.'
    [[ -f "$NATIVE/libuml-sparse-image.so" ]] || fail 'Update the app to install the sparse image utility.'
    mkdir -p "$ENVS"
    DIR="$ENVS/$name"
    resolve_memory
    mkdir "$DIR" 2>/dev/null || fail "Environment already exists: $name"
    printf '%s\n' "$memory" > "$DIR/memory"
    printf '%s\n' "${share_home:-on}" > "$DIR/share-home"
    # Keep interrupted creation for diagnosis; it is never listed as ready.
    gzip -dc "$template" | "$NATIVE/libuml-sparse-image.so" "$DIR/disk.ext4" "$((mb * 1024 * 1024))"
    printf '%s\n' "$type" > "$DIR/type"
    printf '%s\n' "$user" > "$DIR/user"
    echo "Creating $label environment $name (${mb}M) with user $user. Installing sudo and filesystem tools..."
    run_guest create
    grep -q '^UML_ENV_CREATE_OK' "$DIR/console.log" || fail "Creation failed; see $DIR/console.log. Use a new name after resolving the error."
    touch "$DIR/ready"
    echo "Created $name. Enter with: uml-env start $name" ;;
start)
    [[ $# == 1 || ( $# == 3 && $2 == --memory ) ]] || fail 'Usage: uml-env start NAME [--memory SIZE]'
    require_ready "$1"
    [[ $# == 1 ]] || memory=$3
    resolve_memory
    # Kernel UBD locking also prevents a disk from being opened by two guests.
    run_guest start ;;
config)
    [[ $# -ge 1 ]] || fail 'Usage: uml-env config NAME [--memory SIZE] [--share-home on|off]'
    require_ready "$1"
    shift
    new_memory= new_share=
    while [[ $# -gt 0 ]]; do
        [[ $# -ge 2 ]] || fail "Missing value for $1"
        case "$1" in
            --memory) new_memory=$(normalize_memory "$2") ;;
            --share-home) new_share=$(normalize_switch "$2") ;;
            *) fail "Unknown option: $1" ;;
        esac
        shift 2
    done
    [[ -z $new_memory ]] || save_setting memory "$new_memory"
    [[ -z $new_share ]] || save_setting share-home "$new_share"
    [[ -z $new_memory$new_share ]] || echo 'Settings saved; they apply on the next start.'
    memory=$(normalize_memory "$(saved_memory)")
    printf 'Memory: %s\n' "$memory"
    printf 'Share home at /data: %s\n' "$(saved_share_home)"
    ;;
delete)
    [[ $# == 1 || ( $# == 2 && $2 == --yes ) ]] || fail 'Usage: uml-env delete NAME [--yes]'
    valid_name "$1" || fail 'Invalid environment name.'
    DIR="$ENVS/$1"
    [[ -d "$DIR" ]] || fail "Environment not found: $1"
    # Holding the run lock keeps the guest from starting while files go away.
    exec 9>"$DIR/run.lock"
    flock -n 9 || fail 'This environment is running. Shut it down first (sudo poweroff).'
    if [[ $# == 1 ]]; then
        [[ -t 0 ]] || fail 'Add --yes to delete without a prompt.'
        read -r -p "Delete $1 and its disk permanently? Type the name to confirm: " answer
        [[ $answer == "$1" ]] || fail 'Not deleted.'
    fi
    rm -rf "$DIR"
    echo "Deleted $1." ;;
*) usage >&2; exit 1 ;;
esac
