<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TinyhackSSH"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ssh.SshKeysActivity"
            android:exported="false"
            android:label="SSH Key Management"
            android:theme="@style/Theme.TinyhackSSH" />

        <activity
            android:name=".ui.ConnectionProfilesActivity"
            android:exported="false"
            android:label="Connection Profiles"
            android:theme="@style/Theme.TinyhackSSH" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:theme="@style/Theme.TinyhackSSH" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="About"
            android:theme="@style/Theme.TinyhackSSH" />

        <activity
            android:name=".ssh.SshAgentActivity"
            android:exported="false"
            android:label="SSH Agent"
            android:theme="@style/Theme.TinyhackSSH" />

        <activity
            android:name=".ssh.BiometricAuthActivity"
            android:exported="false"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TinyhackSSH.Translucent" />

        <service
            android:name=".service.TerminalService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Terminal Session Manager" />
        </service>

    </application>

</manifest>
