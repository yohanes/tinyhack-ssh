#!/bin/sh
BB=/usr/local/libexec/busybox
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
/usr/bin/hostname "$(cat /etc/hostname)"
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB grep -q ' /dev devtmpfs ' /proc/mounts || $BB mount -t devtmpfs devtmpfs /dev
$BB mkdir -p /dev/pts /dev/shm /run /tmp
$BB mount -t devpts -o gid=5,mode=620 devpts /dev/pts
$BB mount -t tmpfs -o mode=1777 tmpfs /dev/shm
$BB mount -t tmpfs -o mode=755 tmpfs /run
$BB mount -t tmpfs -o mode=1777 tmpfs /tmp
if [ -d /sys/class/net/vec0 ]; then
    $BB ip link set lo up
    $BB ip link set vec0 up
    $BB ip addr add 10.0.2.15/24 dev vec0
    $BB ip route add default via 10.0.2.2
    # Preserve manual DNS edits across boots.
    [ -s /etc/resolv.conf ] || echo 'nameserver 1.1.1.1' > /etc/resolv.conf
fi
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        uml_create=*)
            /usr/local/sbin/uml-create "${arg#uml_create=}" || echo UML_ENV_CREATE_FAILED
            sync
            $BB mount -o remount,ro /
            $BB poweroff -f
            ;;
    esac
done
echo 'TINYHACK_DEBIAN_BOOT_OK'
cat /etc/os-release
echo 'Use apt-get update and apt-get install PACKAGE to extend Debian.'
echo 'Use poweroff for a clean shutdown.'
